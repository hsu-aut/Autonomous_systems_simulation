<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>neo_sim_objects</name>
  <version>0.1.0</version>
  <description>
    Puts objects into the Gazebo simulation, or moves them back to their start
    pose: boxes generated from a size, or any SDF model. Configured in
    config/objects.yaml. Simulation only.
  </description>
  <maintainer email="maintainer@example.com">maintainer</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
