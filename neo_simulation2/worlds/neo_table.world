<?xml version="1.0" ?>
<!--
  neo_table: a grasping practice world.

  One 1.6 x 0.8 m table, top at 0.775 m (the same height as the workshop's cafe
  tables), and one 100 mm cube on it. The robot spawns at the origin facing +x;
  the table is centred 0.95 m in front of it along its long side, so the cube
  sits 0.60 m from the base, well inside the arm's reliable reach.

  No walls on purpose: there is nothing here for a localiser to match, and this
  world is for the arm, not for driving. Launch it without navigation:

      ros2 launch neo_simulation2 bringup.launch.py world:=neo_table use_navigation:=False

  Both world plugins used for grasping are loaded (neo_link_attacher and
  gazebo_ros_state), so attach/detach, collision masks and object poses work here.
-->
<sdf version="1.6">
  <world name="default">

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>0</shadows>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <!-- two point lights either side of the table so neither face of the cube is in shade -->
    <light name="lamp_left" type="point">
      <pose>0.95 1.5 3.0 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>20</range><constant>0.5</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>0</cast_shadows>
    </light>
    <light name="lamp_right" type="point">
      <pose>0.95 -1.5 3.0 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>20</range><constant>0.5</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>0</cast_shadows>
    </light>

    <!-- plain floor; same contact parameters as the workshop's -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- The table. Top surface at z = 0.775: a 40 mm slab centred at 0.755 on
         four 50 mm legs. 1.6 m along y (the robot faces +x, so the long side
         faces the robot), 0.8 m deep. -->
    <model name="practice_table">
      <static>true</static>
      <pose>0.95 0 0 0 0 0</pose>
      <link name="link">
        <collision name="top">
          <pose>0 0 0.755 0 0 0</pose>
          <geometry><box><size>0.8 1.6 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.755 0 0 0</pose>
          <geometry><box><size>0.8 1.6 0.04</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
        <collision name="leg_fl"><pose> 0.35  0.75 0.3675 0 0 0</pose><geometry><box><size>0.05 0.05 0.735</size></box></geometry></collision>
        <collision name="leg_fr"><pose> 0.35 -0.75 0.3675 0 0 0</pose><geometry><box><size>0.05 0.05 0.735</size></box></geometry></collision>
        <collision name="leg_bl"><pose>-0.35  0.75 0.3675 0 0 0</pose><geometry><box><size>0.05 0.05 0.735</size></box></geometry></collision>
        <collision name="leg_br"><pose>-0.35 -0.75 0.3675 0 0 0</pose><geometry><box><size>0.05 0.05 0.735</size></box></geometry></collision>
        <visual name="leg_fl_v"><pose> 0.35  0.75 0.3675 0 0 0</pose><geometry><box><size>0.05 0.05 0.735</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="leg_fr_v"><pose> 0.35 -0.75 0.3675 0 0 0</pose><geometry><box><size>0.05 0.05 0.735</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="leg_bl_v"><pose>-0.35  0.75 0.3675 0 0 0</pose><geometry><box><size>0.05 0.05 0.735</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="leg_br_v"><pose>-0.35 -0.75 0.3675 0 0 0</pose><geometry><box><size>0.05 0.05 0.735</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
      </link>
    </model>

    <!-- The cube: defined here, so it is present without running any tool.
         0.35 m toward the robot from the table centre, i.e. 0.60 m from the base.
         Model name "cube", as in the workshop, so the same attach requests work
         in both worlds. The default objects.yaml of neo_sim_objects holds
         workshop coordinates; do not run it in this world. -->
    <model name="cube">
      <pose>0.60 0 0.825 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>3.333e-04</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>3.333e-04</iyy><iyz>0</iyz>
            <izz>3.333e-04</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
            <contact>
              <ode>
                <kp>1000000.0</kp>
                <kd>100.0</kd>
                <max_vel>0.0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
          <material>
            <ambient>0.85 0.25 0.15 1</ambient>
            <diffuse>0.90 0.30 0.18 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <precon_iters>0</precon_iters>
          <sor>1</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.5</erp>
          <contact_max_correcting_vel>1000</contact_max_correcting_vel>
          <contact_surface_layer>0</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <gravity>0 0 -9.8</gravity>

    <!-- The two world plugins used for grasping. -->
    <plugin name="neo_link_attacher" filename="libneo_link_attacher_plugin.so">
      <ros><namespace>/link_attacher</namespace></ros>
    </plugin>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>10.0</update_rate>
    </plugin>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-2.2 -2.4 2.0 0 0.42 0.72</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
