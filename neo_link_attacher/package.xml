<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>neo_link_attacher</name>
  <version>0.1.0</version>
  <description>
    Gazebo Classic world plugin that attaches and detaches two links with a
    fixed joint over ROS 2 services. Used to secure a grasped object to the
    gripper in simulation, where the kinematically-driven fingers cannot hold
    anything by friction.
  </description>
  <maintainer email="maintainer@example.com">maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>gazebo_ros</depend>
  <depend>gazebo_dev</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- ${prefix} is the package SHARE directory (install/<pkg>/share/<pkg>), so the
         library in install/<pkg>/lib is two levels up. "${prefix}/lib" points at a
         directory that does not exist; the plugin then loads only if a freshly
         sourced shell happens to have install/<pkg>/lib on LD_LIBRARY_PATH. -->
    <gazebo_ros plugin_path="${prefix}/../../lib"/>
  </export>
</package>
