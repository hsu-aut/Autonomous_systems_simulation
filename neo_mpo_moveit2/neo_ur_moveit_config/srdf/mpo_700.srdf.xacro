<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mpo_700">
    <xacro:arg name="prefix" default=""/>
    <xacro:arg name="gripper_type" default=""/>
    <xacro:property name="prefix_value" value="$(arg prefix)"/>
    <xacro:property name="gripper" value="$(arg gripper_type)"/>

    <!--GROUPS: Representation of a set of joints and links. This can be useful for specifying DOF to plan for, defining arms, end effectors, etc-->
    <!--LINKS: When a link is specified, the parent joint of that link (if it exists) is automatically included-->
    <!--JOINTS: When a joint is specified, the child link of that joint (which will always exist) is automatically included-->
    <!--CHAINS: When a chain is specified, all the links along the chain (including endpoints) are included in the group. Additionally, all the joints that are parents to included links are also included. This means that joints along the chain and the parent joint of the base link are included in the group-->
    <!--SUBGROUPS: Groups can also be formed by referencing to already defined group names-->
    <group name="ur_manipulator">
      <joint name="${prefix_value}wrist_1_joint"/>
      <joint name="${prefix_value}wrist_2_joint"/>
      <joint name="${prefix_value}wrist_3_joint"/>
      <joint name="${prefix_value}shoulder_pan_joint"/>
      <joint name="${prefix_value}shoulder_lift_joint"/>
      <joint name="${prefix_value}elbow_joint"/>
    </group>

    <!--GROUP STATES: Purpose: Define a named state for a particular group, in terms of joint values. This is useful to define states like 'folded arms'-->
    <group_state name="up" group="ur_manipulator">
      <joint name="${prefix_value}elbow_joint" value="0" />
      <joint name="${prefix_value}shoulder_lift_joint" value="-1.5707" />
      <joint name="${prefix_value}shoulder_pan_joint" value="0" />
      <joint name="${prefix_value}wrist_1_joint" value="-1.5707" />
      <joint name="${prefix_value}wrist_2_joint" value="0" />
      <joint name="${prefix_value}wrist_3_joint" value="0" />
    </group_state>

    <!-- Arm poses of the pick-and-place mission (Stage_values.md). Joint values in the
         order shoulder_pan, shoulder_lift, elbow, wrist_1, wrist_2, wrist_3 (rad).
         Three poses cover the whole mission; pregrasp and grasp are used at the pick
         table and at the place table:
           home      travel pose, arm folded above the platform
           pregrasp  gripper 16 cm above the grasp/place point: before grasping, lifting
                     the cube, before placing, moving away after placing
           grasp     gripper at the grasp/place point: grasping and placing the cube
         The recorded lift, pre-place and retreat poses differed from pregrasp, and the
         recorded place pose from grasp, by at most 0.11 rad per joint. pregrasp and
         grasp are valid only with the robot at the pick or place position.
         wrist_3 is turned by 90 deg compared with the recorded values (e.g. grasp -1.91 ->
         -0.34): the cube is square, so the fingers line up with its faces either way, and
         the gripper then turns only about 20 deg from home instead of 110 deg. The grasp
         point is unchanged; the fingers close sideways instead of front to back. -->
    <xacro:macro name="stage_pose" params="name pan lift elbow w1 w2 w3">
      <group_state name="${name}" group="ur_manipulator">
        <joint name="${prefix_value}shoulder_pan_joint" value="${pan}" />
        <joint name="${prefix_value}shoulder_lift_joint" value="${lift}" />
        <joint name="${prefix_value}elbow_joint" value="${elbow}" />
        <joint name="${prefix_value}wrist_1_joint" value="${w1}" />
        <joint name="${prefix_value}wrist_2_joint" value="${w2}" />
        <joint name="${prefix_value}wrist_3_joint" value="${w3}" />
      </group_state>
    </xacro:macro>
    <xacro:stage_pose name="home"     pan="1.49" lift="-2.50" elbow="2.00" w1="0.00"  w2="-1.49" w3="0.01"/>
    <xacro:stage_pose name="pregrasp" pan="1.23" lift="-1.97" elbow="2.27" w1="-1.89" w2="-1.57" w3="-0.33"/>
    <xacro:stage_pose name="grasp"    pan="1.23" lift="-1.79" elbow="2.48" w1="-2.25" w2="-1.57" w3="-0.34"/>

    <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->
    <disable_collisions link1="base_footprint" link2="cabinet_link" reason="Adjacent"/>
    <disable_collisions link1="base_footprint" link2="lidar_1_link" reason="Adjacent"/>
    <disable_collisions link1="base_footprint" link2="lidar_2_link" reason="Adjacent"/>
    <disable_collisions link1="base_footprint" link2="mpo_700_caster_back_left_link" reason="Adjacent"/>
    <disable_collisions link1="base_footprint" link2="mpo_700_caster_back_right_link" reason="Adjacent"/>
    <disable_collisions link1="base_footprint" link2="mpo_700_caster_front_left_link" reason="Adjacent"/>
    <disable_collisions link1="base_footprint" link2="mpo_700_caster_front_right_link" reason="Adjacent"/>
    <disable_collisions link1="base_footprint" link2="mpo_700_wheel_back_left_link" reason="Never"/>
    <disable_collisions link1="base_footprint" link2="mpo_700_wheel_back_right_link" reason="Never"/>
    <disable_collisions link1="base_footprint" link2="mpo_700_wheel_front_left_link" reason="Never"/>
    <disable_collisions link1="base_footprint" link2="mpo_700_wheel_front_right_link" reason="Never"/>
    <disable_collisions link1="base_footprint" link2="${prefix_value}base_link_inertia" reason="Never"/>
    <disable_collisions link1="base_footprint" link2="${prefix_value}shoulder_link" reason="Never"/>
    <disable_collisions link1="cabinet_link" link2="lidar_1_link" reason="Adjacent"/>
    <disable_collisions link1="cabinet_link" link2="lidar_2_link" reason="Adjacent"/>
    <disable_collisions link1="cabinet_link" link2="mpo_700_caster_back_left_link" reason="Never"/>
    <disable_collisions link1="cabinet_link" link2="mpo_700_caster_back_right_link" reason="Never"/>
    <disable_collisions link1="cabinet_link" link2="mpo_700_caster_front_left_link" reason="Never"/>
    <disable_collisions link1="cabinet_link" link2="mpo_700_caster_front_right_link" reason="Never"/>
    <disable_collisions link1="cabinet_link" link2="mpo_700_wheel_back_left_link" reason="Never"/>
    <disable_collisions link1="cabinet_link" link2="mpo_700_wheel_back_right_link" reason="Never"/>
    <disable_collisions link1="cabinet_link" link2="mpo_700_wheel_front_left_link" reason="Never"/>
    <disable_collisions link1="cabinet_link" link2="mpo_700_wheel_front_right_link" reason="Never"/>
    <disable_collisions link1="cabinet_link" link2="${prefix_value}base_link_inertia" reason="Adjacent"/>
    <disable_collisions link1="cabinet_link" link2="${prefix_value}shoulder_link" reason="Never"/>
    <disable_collisions link1="lidar_1_link" link2="lidar_2_link" reason="Adjacent"/>
    <disable_collisions link1="lidar_1_link" link2="mpo_700_caster_back_left_link" reason="Never"/>
    <disable_collisions link1="lidar_1_link" link2="mpo_700_caster_back_right_link" reason="Never"/>
    <disable_collisions link1="lidar_1_link" link2="mpo_700_caster_front_left_link" reason="Never"/>
    <disable_collisions link1="lidar_1_link" link2="mpo_700_caster_front_right_link" reason="Never"/>
    <disable_collisions link1="lidar_1_link" link2="mpo_700_wheel_back_left_link" reason="Never"/>
    <disable_collisions link1="lidar_1_link" link2="mpo_700_wheel_back_right_link" reason="Never"/>
    <disable_collisions link1="lidar_1_link" link2="mpo_700_wheel_front_left_link" reason="Never"/>
    <disable_collisions link1="lidar_1_link" link2="mpo_700_wheel_front_right_link" reason="Never"/>
    <disable_collisions link1="lidar_1_link" link2="${prefix_value}base_link_inertia" reason="Never"/>
    <disable_collisions link1="lidar_1_link" link2="${prefix_value}shoulder_link" reason="Never"/>
    <disable_collisions link1="lidar_2_link" link2="mpo_700_caster_back_left_link" reason="Never"/>
    <disable_collisions link1="lidar_2_link" link2="mpo_700_caster_back_right_link" reason="Never"/>
    <disable_collisions link1="lidar_2_link" link2="mpo_700_caster_front_left_link" reason="Never"/>
    <disable_collisions link1="lidar_2_link" link2="mpo_700_caster_front_right_link" reason="Never"/>
    <disable_collisions link1="lidar_2_link" link2="mpo_700_wheel_back_left_link" reason="Never"/>
    <disable_collisions link1="lidar_2_link" link2="mpo_700_wheel_back_right_link" reason="Never"/>
    <disable_collisions link1="lidar_2_link" link2="mpo_700_wheel_front_left_link" reason="Never"/>
    <disable_collisions link1="lidar_2_link" link2="mpo_700_wheel_front_right_link" reason="Never"/>
    <disable_collisions link1="lidar_2_link" link2="${prefix_value}base_link_inertia" reason="Never"/>
    <disable_collisions link1="lidar_2_link" link2="${prefix_value}shoulder_link" reason="Never"/>
    <disable_collisions link1="lidar_2_link" link2="${prefix_value}upper_arm_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_back_left_link" link2="mpo_700_caster_back_right_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_back_left_link" link2="mpo_700_caster_front_left_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_back_left_link" link2="mpo_700_caster_front_right_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_back_left_link" link2="mpo_700_wheel_back_left_link" reason="Adjacent"/>
    <disable_collisions link1="mpo_700_caster_back_left_link" link2="mpo_700_wheel_back_right_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_back_left_link" link2="mpo_700_wheel_front_left_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_back_left_link" link2="mpo_700_wheel_front_right_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_back_left_link" link2="${prefix_value}base_link_inertia" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_back_left_link" link2="${prefix_value}shoulder_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_back_left_link" link2="${prefix_value}upper_arm_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_back_right_link" link2="mpo_700_caster_front_left_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_back_right_link" link2="mpo_700_caster_front_right_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_back_right_link" link2="mpo_700_wheel_back_left_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_back_right_link" link2="mpo_700_wheel_back_right_link" reason="Adjacent"/>
    <disable_collisions link1="mpo_700_caster_back_right_link" link2="mpo_700_wheel_front_left_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_back_right_link" link2="mpo_700_wheel_front_right_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_back_right_link" link2="${prefix_value}base_link_inertia" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_back_right_link" link2="${prefix_value}shoulder_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_back_right_link" link2="${prefix_value}upper_arm_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_front_left_link" link2="mpo_700_caster_front_right_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_front_left_link" link2="mpo_700_wheel_back_left_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_front_left_link" link2="mpo_700_wheel_back_right_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_front_left_link" link2="mpo_700_wheel_front_left_link" reason="Adjacent"/>
    <disable_collisions link1="mpo_700_caster_front_left_link" link2="mpo_700_wheel_front_right_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_front_left_link" link2="${prefix_value}base_link_inertia" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_front_left_link" link2="${prefix_value}shoulder_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_front_right_link" link2="mpo_700_wheel_back_left_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_front_right_link" link2="mpo_700_wheel_back_right_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_front_right_link" link2="mpo_700_wheel_front_left_link" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_front_right_link" link2="mpo_700_wheel_front_right_link" reason="Adjacent"/>
    <disable_collisions link1="mpo_700_caster_front_right_link" link2="${prefix_value}base_link_inertia" reason="Never"/>
    <disable_collisions link1="mpo_700_caster_front_right_link" link2="${prefix_value}shoulder_link" reason="Never"/>
    <disable_collisions link1="mpo_700_wheel_back_left_link" link2="mpo_700_wheel_back_right_link" reason="Never"/>
    <disable_collisions link1="mpo_700_wheel_back_left_link" link2="mpo_700_wheel_front_left_link" reason="Never"/>
    <disable_collisions link1="mpo_700_wheel_back_left_link" link2="mpo_700_wheel_front_right_link" reason="Never"/>
    <disable_collisions link1="mpo_700_wheel_back_left_link" link2="${prefix_value}base_link_inertia" reason="Never"/>
    <disable_collisions link1="mpo_700_wheel_back_left_link" link2="${prefix_value}shoulder_link" reason="Never"/>
    <disable_collisions link1="mpo_700_wheel_back_left_link" link2="${prefix_value}upper_arm_link" reason="Never"/>
    <disable_collisions link1="mpo_700_wheel_back_right_link" link2="mpo_700_wheel_front_left_link" reason="Never"/>
    <disable_collisions link1="mpo_700_wheel_back_right_link" link2="mpo_700_wheel_front_right_link" reason="Never"/>
    <disable_collisions link1="mpo_700_wheel_back_right_link" link2="${prefix_value}base_link_inertia" reason="Never"/>
    <disable_collisions link1="mpo_700_wheel_back_right_link" link2="${prefix_value}shoulder_link" reason="Never"/>
    <disable_collisions link1="mpo_700_wheel_back_right_link" link2="${prefix_value}upper_arm_link" reason="Never"/>
    <disable_collisions link1="mpo_700_wheel_front_left_link" link2="mpo_700_wheel_front_right_link" reason="Never"/>
    <disable_collisions link1="mpo_700_wheel_front_left_link" link2="${prefix_value}base_link_inertia" reason="Never"/>
    <disable_collisions link1="mpo_700_wheel_front_left_link" link2="${prefix_value}shoulder_link" reason="Never"/>
    <disable_collisions link1="mpo_700_wheel_front_left_link" link2="${prefix_value}upper_arm_link" reason="Never"/>
    <disable_collisions link1="mpo_700_wheel_front_right_link" link2="${prefix_value}base_link_inertia" reason="Never"/>
    <disable_collisions link1="mpo_700_wheel_front_right_link" link2="${prefix_value}shoulder_link" reason="Never"/>
    <disable_collisions link1="mpo_700_wheel_front_right_link" link2="${prefix_value}upper_arm_link" reason="Never"/>
    <disable_collisions link1="${prefix_value}base_link_inertia" link2="${prefix_value}shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="${prefix_value}forearm_link" link2="${prefix_value}upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="${prefix_value}forearm_link" link2="${prefix_value}wrist_1_link" reason="Adjacent"/>
    <disable_collisions link1="${prefix_value}forearm_link" link2="${prefix_value}wrist_2_link" reason="Never"/>
    <disable_collisions link1="${prefix_value}shoulder_link" link2="${prefix_value}upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="${prefix_value}wrist_1_link" link2="${prefix_value}wrist_2_link" reason="Adjacent"/>
    <disable_collisions link1="${prefix_value}wrist_1_link" link2="${prefix_value}wrist_3_link" reason="Never"/>
    <disable_collisions link1="${prefix_value}wrist_2_link" link2="${prefix_value}wrist_3_link" reason="Adjacent"/>

    <!-- Assigning Xacro properties -->
    <xacro:unless value="${gripper == ''}">
      <xacro:if value="${gripper == '2f_140'}">
        <xacro:include filename="$(find neo_ur_moveit_config)/srdf/robotiq_2f_140.xacro" />
        <xacro:robotiq_2f_140 />
      </xacro:if>

      <xacro:if value="${gripper == 'epick'}">
        <xacro:include filename="$(find neo_ur_moveit_config)/srdf/robotiq_epick.xacro" />
        <xacro:robotiq_epick />
      </xacro:if>
    </xacro:unless>

</robot>
