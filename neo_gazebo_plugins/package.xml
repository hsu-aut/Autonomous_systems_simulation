<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>neo_gazebo_plugins</name>
  <version>0.1.0</version>
  <description>
    Gazebo Classic plugins for the Neobotix simulation. neo_planar_move is a
    drop-in replacement for gazebo_ros_planar_move that holds the robot in the
    plane without forcing its vertical and tilt velocities to zero every step.
  </description>
  <maintainer email="maintainer@example.com">maintainer</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>gazebo_ros</depend>
  <depend>gazebo_dev</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <export>
    <build_type>ament_cmake</build_type>
    <!-- ${prefix} is the package SHARE directory (install/<pkg>/share/<pkg>), so the
         library in install/<pkg>/lib is two levels up. "${prefix}/lib" points at a
         directory that does not exist; the plugin then loads only if a freshly
         sourced shell happens to have install/<pkg>/lib on LD_LIBRARY_PATH. -->
    <gazebo_ros plugin_path="${prefix}/../../lib"/>
  </export>
</package>
