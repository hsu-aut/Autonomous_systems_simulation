<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>neo_nav2_bringup</name>
  <version>1.0.1</version>
  <description>ROS-2 navigation bringup packages for neobotix robots</description>
  <maintainer email="padmanabhan@neobotix.de">Pradheep Padmanabhan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <depend>navigation2</depend>
  <depend>nav2_common</depend>
  <depend>slam_toolbox</depend>
  <!-- found individually by CMakeLists.txt, started by the launch files -->
  <depend>nav2_amcl</depend>
  <depend>nav2_behaviors</depend>
  <depend>nav2_bt_navigator</depend>
  <depend>nav2_controller</depend>
  <depend>nav2_lifecycle_manager</depend>
  <depend>nav2_map_server</depend>
  <depend>nav2_planner</depend>
  <depend>nav2_waypoint_follower</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>neo_localization2</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- RViz plugins used by rviz/single_robot.rviz -->
  <exec_depend>rviz_default_plugins</exec_depend>
  <exec_depend>nav2_rviz_plugins</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
